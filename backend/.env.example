# AchieverOS Backend Configuration

PROJECT_NAME=AchieverOS
API_V1_STR=/api/v1
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_123456
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL with fallback to SQLite for local zero-config dev)
DATABASE_URL=sqlite:///./achieveros.db
# PostgreSQL with pgvector example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/achieveros

# CORS Settings (frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# NVIDIA Nemotron LLM & Embedding Integration
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-4-340b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/embed-qa-4

# Development Mock Mode (Active if NVIDIA_API_KEY is empty)
AI_MOCK_FALLBACK=true
